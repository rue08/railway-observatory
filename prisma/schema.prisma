// Phase 1 (MVP) schema — see project brief §16, §31, §33 and the
// Delay Intelligence Data Map artifact for the column → source rationale.
//
// Deliberately excludes: OperationalEvent, DataSource, SourceRecord,
// Prediction, ReliabilityScore. Those are Phase 2+ once the live pipeline is
// proven. NewsEvent (below) landed Sept 13 2026 — no longer excluded; it's
// the one entity from the original brief's full list that M4 actually
// needed. WeatherEvent never became its own table (Sept 12 2026, see
// PROJECT.md §4/§9) — weather is columns on StationVisit instead.

generator client {
  provider = "prisma-client-js"
  // "native" keeps local development (`npx prisma generate` on your own
  // machine) working as before. The second target is what actually gets
  // used inside the Docker image (see ../Dockerfile): node:20-alpine on
  // ARM64 is musl-based, not glibc — the plain "linux-arm64" target (built
  // for a Debian/glibc image) would silently produce a client that fails
  // at runtime inside this specific container, not a build-time error.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Static reference data --------------------------------------------
// Loaded from RailRadar's per-train schedule data; refreshed rarely.

model Station {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  // Nullable — no source we have gives coordinates (confirmed against
  // RailRadar's actual endpoints, Aug 29 2026; see PROJECT.md §13). Deferred
  // rather than blocking the reference-data import on a placeholder value.
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeStations RouteStation[]
  visits        StationVisit[]

  @@index([latitude, longitude])
}

model Train {
  id        String   @id @default(cuid())
  number    String   @unique
  name      String
  // Lowercase weekday abbreviations ("mon", "tue", ...) straight from
  // RailRadar's train.runDays — the only consumer is the ingestion
  // scheduler's active-window check (src/scheduler/activeWindow.js), not
  // the schedule/route lookup or normalize-and-correlate, neither of which
  // care what day it is. Empty array, not null, when a provider doesn't
  // send it — hasTodaysDepartureStarted() treats an empty list as "never
  // active" rather than crashing on a missing field.
  runDays   String[] @default([])
  // RailRadar's own train.destination.code (e.g. "JU" for 12307), added
  // Sept 13 2026 (§6/§13). Nullable — trains imported before this field
  // existed have it null until re-imported. Used by normalize-and-
  // correlate's completion backstop as an identity-based check
  // (visit.stationCode === destinationCode) instead of comparing
  // RouteStation's own sequenceNumber against a given day's live-feed
  // sequenceNumber — confirmed those two numbering schemes can genuinely
  // disagree (RouteStation and a specific day's live route each include
  // their own different subset of non-halt technical waypoints), so a
  // sequence-number comparison silently never fired.
  destinationCode String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routeStations RouteStation[]
  runs          TrainRun[]
}

// The train's fixed stop sequence — one set of rows per train, reused by
// every run. arrivalDayOffset/departureDayOffset handle multi-day trains.
model RouteStation {
  id      String @id @default(cuid())
  trainId String
  train   Train  @relation(fields: [trainId], references: [id])

  stationId String
  station   Station @relation(fields: [stationId], references: [id])

  sequenceNumber Int
  // Separate arrival/departure day offsets, not one combined field — an
  // earlier "single day field" assumption was confirmed wrong (Aug 29 2026):
  // it was based on RailRadar's *legacy* endpoint shape, not the one this
  // app actually calls (GET /v1/trains/{number}), which gives arrivalDay and
  // departureDay independently. Null at the origin/terminus respectively.
  arrivalDayOffset   Int?
  departureDayOffset Int?

  // Minutes-since-midnight of the respective day above, null at the
  // origin/terminus respectively. Converted from RailRadar's native
  // "HH:mm" strings at ingestion, not its native format itself — kept as
  // Int here to keep delay-minute arithmetic simple.
  scheduledArrivalTime   Int?
  scheduledDepartureTime Int?

  @@unique([trainId, sequenceNumber])
  @@index([stationId])
}

// ---- Live / operational data -------------------------------------------

enum TrainRunStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

// One instance of a train actually running on a given date.
model TrainRun {
  id      String @id @default(cuid())
  trainId String
  train   Train  @relation(fields: [trainId], references: [id])

  serviceDate    DateTime       @db.Date
  status         TrainRunStatus @default(SCHEDULED)
  sourceProvider String // "railradar" | "indianrailapi" | ...
  createdAt      DateTime       @default(now())

  visits StationVisit[]

  @@unique([trainId, serviceDate])
}

// Append-only observation log. A new row is written only when something
// observable changes (actual time, delay, or reason tag) — not on every
// poll. "Current status" = the newest row per trainRunId, cached in Redis.
model StationVisit {
  id         String   @id @default(cuid())
  trainRunId String
  trainRun   TrainRun @relation(fields: [trainRunId], references: [id])

  stationId      String
  station        Station @relation(fields: [stationId], references: [id])
  sequenceNumber Int

  // Resolved once per (trainRun, station) from RouteStation + serviceDate,
  // so live reads never need to join through the static tables.
  scheduledArrivalAt   DateTime?
  scheduledDepartureAt DateTime?

  actualArrivalAt   DateTime?
  actualDepartureAt DateTime?

  arrivalDelayMinutes   Int? // actual − scheduled, signed (early = negative)
  departureDelayMinutes Int?

  visibilityMeters Int? // weather snapshot at observation time (Phase 1)
  // Raw OpenWeatherMap weather[0].main category ("Rain", "Fog", "Clear",
  // ...) at the same observation, added Sept 12 2026 alongside WeatherAdapter
  // — kept separate from visibilityMeters rather than inferring rain/fog
  // from a visibility threshold, since fog reliably tanks visibility but
  // rain often doesn't, and low visibility can also mean haze/dust that
  // isn't rain/fog at all. §10's rubric rule checks this field directly,
  // not visibilityMeters. Deliberately not further categorized/normalized
  // here — that's the correlation engine's job (§10), not the adapter's.
  weatherCondition String?
  primaryReasonTag String? // nullable until the correlation engine fires

  sourceProvider String
  loggedAt       DateTime @default(now())

  newsMatches NewsEventMatch[]

  @@index([trainRunId, sequenceNumber])
  @@index([stationId, loggedAt])
}

// ---- Event intelligence (M4) --------------------------------------------

// One Google News RSS item — PROJECT.md §4/§9, built Sept 13 2026. Kept
// deliberately unstructured beyond what the feed itself gives (no tagged
// train-number/category fields): matching against StationVisit is done by
// scanning `title` text at match time (see newsMatching.js), not by
// expecting the source to hand us structured tags.
model NewsEvent {
  id  String @id @default(cuid())
  // The feed's <link> — a Google-wrapped redirect URL, not the original
  // publisher's URL. Still unique per item and stable across polls, so it
  // works fine as the natural upsert key without a separate externalId.
  sourceUrl String @unique
  title     String
  // From the feed's own <source> tag, not split out of `title` — real
  // fetched data (Sept 13 2026) showed <source> is already a clean,
  // separate field, more robust than string-splitting title on " - "
  // (which a headline containing its own hyphenated fragment could break).
  sourceOutlet String?
  publishedAt  DateTime
  // Single value for now ("established-outlet") since every Google News
  // hit so far has been real journalism — per-outlet trust ranking (Hindu/
  // Indian Express vs. an unfamiliar site) is a still-open question, not
  // decided (PROJECT.md §9).
  trustTier String @default("established-outlet")
  createdAt DateTime @default(now())

  matches NewsEventMatch[]

  @@index([publishedAt])
}

// The link between a NewsEvent and a StationVisit it plausibly explains —
// the "geo/temporal correlation" M4 is scoped to produce. A join table, not
// a bare FK either direction, since one incident can plausibly explain
// several observed delays and (in principle) one delay could get matched by
// more than one news item. Created by newsMatching.js, from whichever side
// (a new NewsEvent or a new delayed StationVisit) runs the match second —
// `@@unique` makes creating it from both directions safe to attempt.
//
// Deliberately just the link plus what matched on — no score, no evidence
// text, no tier. Turning this into points/evidence for primaryReasonTag is
// M5's job (PROJECT.md §10/§13), not M4's.
model NewsEventMatch {
  id String @id @default(cuid())

  newsEventId String
  newsEvent   NewsEvent @relation(fields: [newsEventId], references: [id])

  stationVisitId String
  stationVisit   StationVisit @relation(fields: [stationVisitId], references: [id])

  // "trainNumber" | "stationName" — which text-match rule fired, per §4's
  // "matching by train-number-in-title first, station-name-in-title as
  // fallback" design.
  matchedOn String
  createdAt DateTime @default(now())

  @@unique([newsEventId, stationVisitId])
}
