# Copy to .env and fill in. .env is gitignored.

NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml service `postgres`)
POSTGRES_USER=railway_delay
POSTGRES_PASSWORD=railway_delay
POSTGRES_DB=railway_delay
DATABASE_URL="postgresql://railway_delay:railway_delay@127.0.0.1:5433/railway_delay?schema=public"

# Redis (matches docker-compose.yml service `redis`)
REDIS_URL="redis://127.0.0.1:6379"

# Railway data provider (M2 — leave blank for now)
RAILRADAR_API_KEY=

# Weather (M2)
OPENWEATHERMAP_API_KEY=

# data.gov.in (static reference data — timetable, station master, punctuality)
DATA_GOV_IN_API_KEY=
