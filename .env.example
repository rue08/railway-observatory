# Copy to .env and fill in. .env is gitignored.

NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml service `postgres`)
POSTGRES_USER=railway_observatory
POSTGRES_PASSWORD=railway_observatory
POSTGRES_DB=railway_observatory
DATABASE_URL="postgresql://railway_observatory:railway_observatory@127.0.0.1:5433/railway_observatory?schema=public"

# Redis (matches docker-compose.yml service `redis`)
REDIS_URL="redis://127.0.0.1:6379"

# Railway data provider (M2 — leave blank for now)
RAILRADAR_API_KEY=

# Ingestion scheduler (M3) — which trains it polls, and how often.
# See docs/tracked-trains.md for the quota math behind these defaults.
TRACKED_TRAINS=12307,12308
SCHEDULER_POLL_INTERVAL_MINUTES=75

# Weather (M2)
OPENWEATHERMAP_API_KEY=

# News (M4) — Google News RSS, no key needed. How often it's polled.
NEWS_POLL_INTERVAL_MINUTES=60

# Delay attribution (M5) — how often delayed visits are re-scanned for new
# evidence (news arriving after the visit was first written).
DELAY_ATTRIBUTION_POLL_INTERVAL_MINUTES=60

# data.gov.in (static reference data — timetable, station master, punctuality)
DATA_GOV_IN_API_KEY=
